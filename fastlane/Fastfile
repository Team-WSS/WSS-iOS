default_platform(:ios)

platform :ios do
  desc "App Store Connect 배포 (Release)"
  lane :appstore do
    match(type: "appstore")

    build_app(
      scheme: "WSSiOS",
      configuration: "Release",
      export_method: "app-store",
      output_name: "WSSiOS.ipa"
    )

    upload_to_app_store
  end

  desc "TestFlight 내부 배포 (Debug)"
  lane :internal do
    match(type: "development")

    today = Time.now.strftime("%Y%m%d")
    existing_builds = sh("xcrun altool --list-apps -u $FASTLANE_USER -p $FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD 2>/dev/null | grep #{today}").split("\n")
    today_build_count = existing_builds
                          .map { |line| line[/#{today}(\d{2})/, 1] }
                          .compact
                          .map(&:to_i)
                          .max.to_i + 1

    new_build_number = "#{today}#{format('%02d', today_build_count)}"
    UI.message("✅ 빌드 넘버: #{new_build_number}")

    increment_build_number(
      build_number: new_build_number
    )

    build_app(
      scheme: "WSSiOS",
      configuration: "Debug",
      export_method: "development",
      output_name: "WSSiOS_DEV.ipa"
    )

    upload_to_testflight(distribute_external: false)
  end
end
